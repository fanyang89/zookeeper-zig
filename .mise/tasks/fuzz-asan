#!/usr/bin/env bash
#MISE description="Run libFuzzer fuzz targets with address sanitizer"
set -euo pipefail

export ASAN_OPTIONS="detect_leaks=1:halt_on_error=1${ASAN_OPTIONS:+:$ASAN_OPTIONS}"
runtime_dir=$(clang --print-runtime-dir)
mkdir -p tests/.runtime/fuzz
exec zig build fuzz -Dfuzz=true -Dsanitize=address -Dclang-runtime-dir="$runtime_dir" -- \
    -max_total_time="${FUZZ_DURATION:-60}" -max_len="${FUZZ_MAX_LEN:-4096}" \
    -artifact_prefix=tests/.runtime/fuzz/ "$@"
