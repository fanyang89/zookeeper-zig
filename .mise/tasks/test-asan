#!/usr/bin/env bash
#MISE description="Run unit tests with address sanitizer"
set -euo pipefail

export ASAN_OPTIONS="detect_leaks=1:halt_on_error=1${ASAN_OPTIONS:+:$ASAN_OPTIONS}"
runtime_dir=$(clang --print-runtime-dir)
exec zig build test -Dsanitize=address -Dasan-runtime-dir="$runtime_dir" "$@"
