#!/usr/bin/env bash
#MISE description="Run chaos test: inject network faults against a live ZK server"
set -euo pipefail

compose_file=${E2E_COMPOSE_FILE:-tests/e2e/compose.yaml}
project=${E2E_PROJECT:-zookeeper-zig-chaos}
hosts=${E2E_HOSTS:-127.0.0.1:22181}
compose=(docker compose --project-name "$project" --file "$compose_file")

cleanup() {
    status=$?
    trap - EXIT
    if (( status != 0 )); then
        "${compose[@]}" logs --no-color 2>/dev/null || true
    fi
    "${compose[@]}" down --volumes --remove-orphans 2>/dev/null || true
    exit "$status"
}
trap cleanup EXIT

# Start ZK
"${compose[@]}" up --detach --wait --wait-timeout 60

# Build the chaos client
zig build chaos

# Start chaos client in the background
echo "Starting chaos client (session timeout 10s) ..."
zig-out/bin/chaos_mt "$hosts" &
CLIENT_PID=$!

# ── Fault injection ───────────────────────────────────────────────

sleep 8
echo ">>> [chaos] STOP 3s + START — brief outage (session survives)"
"${compose[@]}" stop -t 1 zookeeper
sleep 3
"${compose[@]}" start zookeeper
# wait for ZK to accept connections
for i in $(seq 1 15); do
    "${compose[@]}" exec -T zookeeper sh -c 'echo ruok | nc localhost 2181' 2>/dev/null | grep -q imok && break
    sleep 1
done

sleep 8
echo ">>> [chaos] STOP 15s + START — long outage (session expires)"
"${compose[@]}" stop -t 1 zookeeper
sleep 15
"${compose[@]}" start zookeeper
for i in $(seq 1 15); do
    "${compose[@]}" exec -T zookeeper sh -c 'echo ruok | nc localhost 2181' 2>/dev/null | grep -q imok && break
    sleep 1
done

sleep 8
echo ">>> [chaos] KILL + UP — full crash + fresh container"
"${compose[@]}" kill zookeeper 2>/dev/null || true
sleep 2
"${compose[@]}" up --detach --wait --wait-timeout 60 zookeeper

# Wait for client to finish
wait "$CLIENT_PID"
