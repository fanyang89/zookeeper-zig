#!/usr/bin/env bash
#MISE description="Run TLS ZooKeeper end-to-end tests"
set -euo pipefail

tests/e2e/generate-tls-certs
export E2E_COMPOSE_FILE=tests/e2e/compose-tls.yaml
export E2E_PROJECT=zookeeper-zig-e2e-tls
export E2E_HOSTS=127.0.0.1:22281
export E2E_TLS_CERT=tests/.runtime/tls/ca.crt,tests/.runtime/tls/client.crt,tests/.runtime/tls/client.key,changeit
exec .mise/tasks/e2e
