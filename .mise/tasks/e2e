#!/usr/bin/env bash
#MISE description="Run single-node ZooKeeper end-to-end tests"
set -euo pipefail

compose_file=${E2E_COMPOSE_FILE:-tests/e2e/compose.yaml}
project=${E2E_PROJECT:-zookeeper-zig-e2e}
hosts=${E2E_HOSTS:-127.0.0.1:22181}
compose=(docker compose --project-name "$project" --file "$compose_file")

cleanup() {
    status=$?
    trap - EXIT
    if (( status != 0 )); then
        "${compose[@]}" logs --no-color
    fi
    "${compose[@]}" down --volumes --remove-orphans
    exit "$status"
}
trap cleanup EXIT

"${compose[@]}" up --detach --wait --wait-timeout 60
zig build e2e -- "$hosts"
