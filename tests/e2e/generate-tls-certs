#!/usr/bin/env bash
set -euo pipefail

runtime=tests/.runtime/tls
rm -rf "$runtime"
mkdir -p "$runtime"

openssl req -x509 -newkey rsa:2048 -sha256 -nodes -days 2 \
    -subj /CN=zookeeper-zig-test-ca \
    -keyout "$runtime/ca.key" -out "$runtime/ca.crt" >/dev/null 2>&1

openssl req -newkey rsa:2048 -sha256 -nodes -subj /CN=localhost \
    -keyout "$runtime/server.key" -out "$runtime/server.csr" >/dev/null 2>&1
openssl x509 -req -sha256 -days 2 -in "$runtime/server.csr" \
    -CA "$runtime/ca.crt" -CAkey "$runtime/ca.key" -CAcreateserial \
    -extfile tests/e2e/openssl.cnf -extensions server \
    -out "$runtime/server.crt" >/dev/null 2>&1

openssl req -newkey rsa:2048 -sha256 -nodes -subj /CN=zookeeper-zig-client \
    -keyout "$runtime/client.key" -out "$runtime/client.csr" >/dev/null 2>&1
openssl x509 -req -sha256 -days 2 -in "$runtime/client.csr" \
    -CA "$runtime/ca.crt" -CAkey "$runtime/ca.key" -CAcreateserial \
    -extfile tests/e2e/openssl.cnf -extensions client \
    -out "$runtime/client.crt" >/dev/null 2>&1

openssl pkcs12 -export -name zookeeper -in "$runtime/server.crt" \
    -inkey "$runtime/server.key" -certfile "$runtime/ca.crt" \
    -out "$runtime/server.p12" -passout pass:changeit
keytool -importcert -noprompt -alias ca -file "$runtime/ca.crt" \
    -keystore "$runtime/truststore.p12" -storetype PKCS12 \
    -storepass changeit >/dev/null 2>&1
